# forksmartdns — isolated SmartDNS/HRDNS instance + management WebUI.
# Generated by install.sh. The WebUI owns the sections marked fsd:*.
# You may edit this file manually, but keep the fsd:* markers intact.
#
# The instance is deliberately independent from the Hydra Route hrdns
# installation: its own binary, pid, config, logs, data and ports.

# >>> fsd:globals
cache-size 4096
cache-persist yes
cache-checkpoint-time 600
cache-file @VAR@/cache.dat
data-dir @VAR@
prefetch-domain no
serve-expired yes
serve-expired-ttl 86400
serve-expired-reply-ttl 3
dualstack-ip-selection yes
response-mode first-ping
speed-check-mode ping,tcp:443
max-reply-ip-num 8
log-level notice
log-file @LOG@/forksmartdns.log
log-size 256k
log-num 2
log-console no
log-syslog no
audit-enable yes
audit-SOA no
audit-file @LOG@/audit.log
audit-size 512k
audit-num 2
ui-enable yes
ui-listen 127.0.0.1:@UI_INTERNAL_PORT@
ui-data-dir @VAR@/ui
ui-days 7
ui-max-mb 64
ui-flush-seconds 60
# <<< fsd:globals

# >>> fsd:listeners
bind @DNS_BIND@:@DNS_PORT@
bind-tcp @DNS_BIND@:@DNS_PORT@
# <<< fsd:listeners

# >>> fsd:upstreams
server 223.5.5.5
server 1.1.1.1
# <<< fsd:upstreams

# >>> fsd:groups
# <<< fsd:groups

# >>> fsd:domains
# <<< fsd:domains

# >>> fsd:lists
# <<< fsd:lists

# >>> fsd:clients
# <<< fsd:clients

# >>> fsd:ipset
# <<< fsd:ipset

# >>> fsd:extra
# <<< fsd:extra
